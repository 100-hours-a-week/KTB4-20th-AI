# 실제 값은 .env 파일에 넣고 커밋하지 않는다 (.gitignore에 이미 등록됨)
# 도메인별로 더 필요한 환경변수는 각 기능 브랜치에서 추가한다.

# Gemini API (trips, photomissions 공통)
GEMINI_API_KEY=

# 백엔드 <-> AI 서버 내부 서비스 인증 토큰 (BE와 값 맞춰야 함 — 아직 미정)
INTERNAL_SERVICE_TOKEN=

# verify에서 이미지 다운로드를 허용할 호스트 (쉼표로 구분, SSRF 방지용)
# 예: my-bucket.s3.ap-northeast-2.amazonaws.com
ALLOWED_IMAGE_HOSTS=
