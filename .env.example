# 실제 값은 .env 파일에 넣고 커밋하지 않는다 (.gitignore에 이미 등록됨)
# 도메인별로 더 필요한 환경변수는 각 기능 브랜치에서 추가한다.

# Gemini API (trips, photomissions 공통)
GEMINI_API_KEY=

# 백엔드 <-> AI 서버 내부 서비스 인증 토큰 (BE와 같은 값. 실제 값은 DM으로 공유)
INTERNAL_SERVICE_TOKEN=

# verify에서 이미지 다운로드를 허용할 호스트 (쉼표로 구분, SSRF 방지용)
# 예: my-bucket.s3.ap-northeast-2.amazonaws.com
ALLOWED_IMAGE_HOSTS=

# Sentry 에러 모니터링 (DSN이 비어 있으면 꺼짐)
SENTRY_DSN=
# local / dev / prod
SENTRY_ENVIRONMENT=local
# 성능 추적 비율 (0.0 ~ 1.0, 0이면 끔)
SENTRY_TRACES_SAMPLE_RATE=0.0

# 장소 추천
GOOGLE_PLACES_API_KEY=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
RUNPOD_MODEL_URL=
RUNPOD_MODEL_API_KEY=
# 기상청(공공데이터포털) 단기·중기 예보 인증키. 두 서비스에 같은 키를 쓴다. Decoding 값을 넣는다(Encoding 값은 한 번 더 인코딩되어 실패할 수 있음). 비어 있으면 precheck가 503
KMA_API_KEY=
# 선택: 예보 캐시 유효 시간(초, 기본 1800), 기상청 호출 대기 시간(초, 기본 10)
# PRECHECK_CACHE_TTL_SECONDS=
# KMA_TIMEOUT_SECONDS=

# verify 판정 모델: gemini(기본) / self(자체 모델). generate는 항상 Gemini
# self로 바꾸려면 아래 값이 모두 필요하다(점수 기준은 VLM_FORMAT=score일 때만). 하나라도 비면 서버가 시작되지 않는다
VERIFY_BACKEND=gemini
# 자체 모델 답 형식: score(점수 + 아래 판정 기준, 기본) / question(객관식 4문항 + 등급 규칙, 판정 기준 불필요)
VLM_FORMAT=score
# 예: https://<서버>/v1
VLM_BASE_URL=
VLM_MODEL=
# 자체 모델 서버 API 키 (측정 스크립트도 이 값을 씀). 키가 필요 없는 로컬 Ollama는 비워 둔다
VLM_API_KEY=
# 숫자 값은 빈 문자열이면 읽지 못하므로 쓸 때만 주석을 풀고 값을 넣는다
# 판정 한 번에 자체 모델을 기다리는 전체 시간(초, 재시도 포함). 콜드스타트 측정 후 정한다
# VLM_DEADLINE_SECONDS=
# 폴백: 자체 모델이 실패하거나 운영 시간 밖이면 Gemini로 판정한다. 설정해야 켜진다(GEMINI_API_KEY 필요)
# 자체 모델 + Gemini를 합친 모델 판정 단계의 전체 상한(초). 백엔드가 30초까지 기다리므로 20 안팎으로 둔다
# VERIFY_MODEL_BUDGET_SECONDS=
# 자체 모델(Pod) 운영 시간, 한국 시간 HH:MM-HH:MM(시작 포함·끝 제외). 밖이면 바로 Gemini. 쓰려면 위 예산도 필요
VLM_SERVING_HOURS=
# 자체 모델용 판정 기준 (VLM_FORMAT=score만, 0~100, 재시도 ≤ 성공). Gemini 기준을 그대로 쓰지 않는다
# SELF_SUCCESS_THRESHOLD=
# SELF_RETRY_THRESHOLD=
# SELF_LANDMARK_THRESHOLD=
